<!DOCTYPE html> [% USE HTML %][% USE Dumper %]
<!-- vim: set filetype=tt2html ai ts=4 sw=4: -->
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        [% IF config.exists("stylesheet") -%]
            [% FOREACH css IN config.stylesheet.split('\|') %]
            <link rel="stylesheet" href="[% css %]">
            [% END %]
        [% END %]
        <title>[% HTML.escape( results.name ) %]</title>

    </head>
    <body>
        <div id="prefvote_div">
            <h1>Vote count: [% HTML.escape( results.name ) %]</h1>

            [%# header %]
            <p>
            [% IF results.seats == 0 -%]
            ranking order
            [%- ELSE -%]
            [% results.total_ballots %] seat[% IF results.seats > 1 %]s[% END %] available
            [%- END %]
            &#x26AB; [% HTML.escape( results.total_ballots ) %] ballots processed
            <!-- &#x26AB; [% results.timestamp %] -->
            </p>

            [%# toc %]
            [% html_table( "rows", param.toc_rows, "header_row", 1, "rating_bounds", 1 ) %]

            [%# tables %]
            [% FOREACH table IN param.tables %]
                [% IF table.exists("title") %]
                    <h3>[% HTML.escape( table.title ) %]</h3>
                [% END %]
                [% IF table.exists("subtitle") %]
                    <p>[% HTML.escape( table.subtitle ) %]</p>
                [% END %]
                [% html_table( "rows", table.result_rows, "header_row", 1 ) %]
            [% END %]

            <!--
            <hr>
            <pre>config: [%# Dumper.dump_html(config) %]</pre>
            <hr>
            <pre>param: [%# Dumper.dump_html(param) %]</pre>
            <hr>
            <pre>results: [%# Dumper.dump_html(results) %]</pre>
            -->
        </div>
    </body>
</html>

